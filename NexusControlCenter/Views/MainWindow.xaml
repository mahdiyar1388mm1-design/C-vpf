<Window x:Class="NexusControlCenter.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:NexusControlCenter.Controls" Title="Nexus Control Center" Width="1440" Height="920" MinWidth="1080" MinHeight="700" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.InputBindings><KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Overview"/><KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="System Monitor"/><KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Task Manager"/><KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="File Manager"/><KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Analytics"/><KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}"/></Window.InputBindings>
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/><Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="5"/></Style><Style TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#0C1425"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><ContentPresenter ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><ContentPresenter ContentSource="Content"/></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0A0F1B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0"><Border Width="21" Height="21" CornerRadius="6" Background="{DynamicResource AccentBrush}"><TextBlock Text="N" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="NEXUS" Margin="9,0,0,0" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="CONTROL CENTER" Margin="8,0,0,0" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Width="44" Background="Transparent" Foreground="{DynamicResource MutedBrush}" BorderThickness="0" Click="Minimize_Click"/><Button Content="□" Width="44" Background="Transparent" Foreground="{DynamicResource MutedBrush}" BorderThickness="0" Click="Maximize_Click"/><Button Content="×" Width="44" Background="Transparent" Foreground="{DynamicResource MutedBrush}" BorderThickness="0" Click="Close_Click"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#0D1423" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Margin="16,22,16,10"><Border CornerRadius="13" Padding="13" Background="#14203A" BorderBrush="#263854" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="10" Background="#203968"><TextBlock Text="◈" FontSize="20" Foreground="#85A9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Nexus" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="INTELLIGENCE PLATFORM" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Grid></Border></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,18"><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,0,4,14"/><Button Style="{StaticResource NavButton}" Content="⚙   Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><Border Margin="2,12,2,0" Background="#121A2D" CornerRadius="10" Padding="11"><StackPanel><TextBlock Text="SYSTEM STATUS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse Width="7" Height="7" Fill="#35D39A" VerticalAlignment="Center"/><TextBlock Text="  Monitoring active" FontSize="11" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="●" Foreground="#35D39A" Margin="4,0,0,0"/></StackPanel></StackPanel></Border></StackPanel>
    <StackPanel Margin="12,12,12,0"><TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="#586781" Margin="12,8,0,8"/><Button Style="{StaticResource NavButton}" Content="◫   Overview" Command="{Binding NavigateCommand}" CommandParameter="Overview"/><Button Style="{StaticResource NavButton}" Content="⌁   System Monitor" Command="{Binding NavigateCommand}" CommandParameter="System Monitor"/><Button Style="{StaticResource NavButton}" Content="▤   Task Manager" Command="{Binding NavigateCommand}" CommandParameter="Task Manager"/><Button Style="{StaticResource NavButton}" Content="▱   File Manager" Command="{Binding NavigateCommand}" CommandParameter="File Manager"/><Button Style="{StaticResource NavButton}" Content="◷   Analytics Center" Command="{Binding NavigateCommand}" CommandParameter="Analytics"/></StackPanel>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="28,0,28,0"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ActiveModule}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding HostSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Grid Width="248" Margin="0,0,12,0"><TextBox Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/><TextBlock Text="⌕" Margin="0,0,11,0" FontSize="18" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/><Grid.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></Grid.InputBindings></Grid><Button Style="{StaticResource QuietButton}" Content="↻" FontSize="16" ToolTip="Refresh system snapshot" Command="{Binding RefreshCommand}"/><Border Width="35" Height="35" CornerRadius="18" Background="#293B61" Margin="12,0,0,0"><TextBlock Text="N" Foreground="#A9C0FF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border></StackPanel></Grid>
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
     <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,0,18"><Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Good to have you back" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Your system at a glance. Live telemetry refreshes automatically." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="20" Padding="12,7" Background="#14291F" BorderBrush="#244C39" BorderThickness="1"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#39D89C"/><TextBlock Text="  LIVE SYSTEM" FontSize="9" Foreground="#81E1B7" FontWeight="Bold"/></StackPanel></Border></Grid>
      <UniformGrid Columns="4" Margin="0,0,0,16">
       <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><DockPanel><TextBlock Text="PROCESSOR" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/><TextBlock Text="◉" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontSize="17"/></DockPanel><TextBlock Text="{Binding CpuText}" FontSize="27" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock Text="Real-time utilization" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><controls:SparklineChart Height="38" Margin="0,8,0,0" Values="{Binding CpuHistory}" Stroke="{DynamicResource AccentBrush}" SecondaryValues="{Binding MemoryHistory}" SecondaryStroke="{DynamicResource PurpleBrush}"/></StackPanel></Border>
       <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><DockPanel><TextBlock Text="MEMORY" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/><TextBlock Text="▦" DockPanel.Dock="Right" Foreground="{DynamicResource PurpleBrush}" FontSize="17"/></DockPanel><TextBlock Text="{Binding Snapshot.MemoryPercent, StringFormat={}{0:F0}%}" FontSize="27" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock Text="{Binding MemoryText}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><ProgressBar Value="{Binding Snapshot.MemoryPercent}" Maximum="100" Height="4" Margin="0,21,0,0" Background="#27314A" Foreground="{DynamicResource PurpleBrush}"/></StackPanel></Border>
       <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><DockPanel><TextBlock Text="SYSTEM DISK" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/><TextBlock Text="▰" DockPanel.Dock="Right" Foreground="#42C7BC" FontSize="17"/></DockPanel><TextBlock Text="{Binding Snapshot.DiskPercent, StringFormat={}{0:F0}%}" FontSize="27" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock Text="{Binding DiskText}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><ProgressBar Value="{Binding Snapshot.DiskPercent}" Maximum="100" Height="4" Margin="0,21,0,0" Background="#27314A" Foreground="#42C7BC"/></StackPanel></Border>
       <Border Style="{StaticResource PanelCard}"><StackPanel><DockPanel><TextBlock Text="NETWORK" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/><TextBlock Text="⌁" DockPanel.Dock="Right" Foreground="#FFB86C" FontSize="19"/></DockPanel><TextBlock Text="{Binding NetworkText}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,7"/><TextBlock Text="Live throughput · Mbps" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Snapshot.ProcessCount, StringFormat={}{0} processes active}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Performance overview" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="CPU and memory utilization · last 60 readings" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#202C45" CornerRadius="7" Padding="9,5"><TextBlock Text="LIVE" FontSize="9" Foreground="#A8C2FF" FontWeight="Bold"/></Border></DockPanel><controls:SparklineChart Grid.Row="1" Height="210" Margin="0,20,0,6" Values="{Binding CpuHistory}" Stroke="{DynamicResource AccentBrush}" SecondaryValues="{Binding MemoryHistory}" SecondaryStroke="{DynamicResource PurpleBrush}"/><Grid Grid.Row="2"><TextBlock Text="-60 sec" Foreground="{DynamicResource MutedBrush}" FontSize="9"/><TextBlock Text="NOW" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="9"/></Grid></Grid></Border>
       <Border Grid.Column="1" Style="{StaticResource PanelCard}"><StackPanel><Grid><StackPanel><TextBlock Text="Quick actions" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Jump into your workspace" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><TextBlock Text="✦" HorizontalAlignment="Right" Foreground="{DynamicResource PurpleBrush}" FontSize="19"/></Grid><Button Style="{StaticResource QuietButton}" Margin="0,18,0,9" HorizontalContentAlignment="Left" Command="{Binding OpenMonitorCommand}"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Foreground="{DynamicResource AccentBrush}" FontSize="18"/><StackPanel Margin="12,0,0,0"><TextBlock Text="Open system monitor" FontWeight="SemiBold"/><TextBlock Text="Hardware and live metrics" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel></Button><Button Style="{StaticResource QuietButton}" Margin="0,0,0,9" HorizontalContentAlignment="Left" Command="{Binding OpenFilesCommand}"><StackPanel Orientation="Horizontal"><TextBlock Text="▱" Foreground="{DynamicResource PurpleBrush}" FontSize="18"/><StackPanel Margin="12,0,0,0"><TextBlock Text="Browse files" FontWeight="SemiBold"/><TextBlock Text="Explore your storage" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel></Button><Button Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="Task Manager"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="#42C7BC" FontSize="18"/><StackPanel Margin="12,0,0,0"><TextBlock Text="Manage processes" FontWeight="SemiBold"/><TextBlock Text="Review and control apps" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel></Button></StackPanel></Border></Grid>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><DockPanel><TextBlock Text="Recent activity" FontSize="14" FontWeight="SemiBold"/><Button Content="View history  →" DockPanel.Dock="Right" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Analytics" FontSize="10" Padding="6,4"/></DockPanel><ItemsControl ItemsSource="{Binding Activities}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="No recent activity recorded" Foreground="{DynamicResource MutedBrush}" FontSize="11" Visibility="Collapsed"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="Device details" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="HOSTNAME" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,17,0,3"/><TextBlock Text="{Binding Snapshot.HostName}" FontSize="12"/><TextBlock Text="OPERATING SYSTEM" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,13,0,3"/><TextBlock Text="{Binding Snapshot.OperatingSystem}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="SYSTEM UPTIME" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,13,0,3"/><TextBlock Text="{Binding UptimeText}" FontSize="12"/></StackPanel></Border></Grid>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,0,18"><TextBlock Text="System Monitor" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Live hardware telemetry collected from Windows system APIs." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,18"/><UniformGrid Columns="3" Margin="0,0,0,16"><Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PROCESSOR LOAD" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding CpuText}" FontSize="32" FontWeight="SemiBold" Margin="0,9"/><ProgressBar Value="{Binding Snapshot.CpuPercent}" Maximum="100" Height="5" Foreground="{DynamicResource AccentBrush}" Background="#29334A"/><TextBlock Text="Calculated from kernel and user processor time" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PHYSICAL MEMORY" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Snapshot.MemoryPercent, StringFormat={}{0:F1}%}" FontSize="32" FontWeight="SemiBold" Margin="0,9"/><TextBlock Text="{Binding MemoryText}"/><ProgressBar Value="{Binding Snapshot.MemoryPercent}" Maximum="100" Height="5" Margin="0,14,0,0" Foreground="{DynamicResource PurpleBrush}" Background="#29334A"/><TextBlock Text="Installed physical memory usage" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="NETWORK THROUGHPUT" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding NetworkText}" FontSize="19" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock Text="Aggregated active network adapters · IPv4" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding Snapshot.ProcessCount, StringFormat={}{0} processes detected}" Margin="0,14,0,0"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource PanelCard}"><StackPanel><DockPanel><TextBlock Text="Live performance history" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="60-second window" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></DockPanel><controls:SparklineChart Height="300" Margin="0,18,0,8" Values="{Binding CpuHistory}" Stroke="{DynamicResource AccentBrush}" SecondaryValues="{Binding MemoryHistory}" SecondaryStroke="{DynamicResource PurpleBrush}"/><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Text=" CPU utilization" Margin="6,0,0,0" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><Ellipse Width="7" Height="7" Fill="{DynamicResource PurpleBrush}" VerticalAlignment="Center" Margin="20,0,0,0"/><TextBlock Text=" Memory utilization" Margin="6,0,0,0" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
     <TabItem><Grid Margin="0,8,0,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><StackPanel><TextBlock Text="Task Manager" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Inspect running processes and terminate unresponsive or unwanted apps." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource QuietButton}" Content="↻ Refresh" Command="{Binding RefreshProcessesCommand}"/><Button Style="{StaticResource ActionButton}" Content="End task" Margin="8,0,0,0" Background="#BD4C61" Command="{Binding KillProcessCommand}"/></StackPanel></Grid><Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="8"><DataGrid x:Name="ProcessGrid" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="CPU" Binding="{Binding CpuPercent, StringFormat={}{0:F1}%}" Width="*"/><DataGridTextColumn Header="MEMORY" Binding="{Binding MemoryMb, StringFormat={}{0:F1} MB}" Width="*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="WINDOW" Binding="{Binding WindowTitle}" Width="2*"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
     <TabItem><Grid Margin="0,8,0,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,15"><StackPanel><TextBlock Text="File Manager" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Browse folders, inspect file details, and open files using their default Windows app." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource QuietButton}" Content="↑ Parent" Command="{Binding ParentFolderCommand}"/><Button Style="{StaticResource QuietButton}" Content="↻" Margin="7,0" Command="{Binding RefreshFilesCommand}"/><Button Style="{StaticResource ActionButton}" Content="Open" Command="{Binding OpenFileCommand}"/></StackPanel></Grid><Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding FileQuery, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" ToolTip="Search current folder"/><Button Grid.Column="2" Content="Search" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Command="{Binding SearchFilesCommand}"/></Grid><Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="8"><DataGrid x:Name="FileGrid" ItemsSource="{Binding Files}" MouseDoubleClick="FileGrid_MouseDoubleClick" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2.5*"/><DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="*"/><DataGridTextColumn Header="MODIFIED" Binding="{Binding Modified}" Width="1.5*"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
     <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,0,18"><Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Analytics Center" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Explore the live performance window and export a report." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource QuietButton}" Content="Export CSV" Command="{Binding ExportCsvCommand}"/><Button Style="{StaticResource ActionButton}" Content="Export PDF" Margin="8,0,0,0" Command="{Binding ExportPdfCommand}"/></StackPanel></Grid><UniformGrid Columns="3" Margin="0,0,0,15"><Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="SESSION SAMPLE COUNT" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding CpuHistory.Count, StringFormat={}{0} samples}" FontSize="23" FontWeight="SemiBold" Margin="0,9"/><TextBlock Text="Collected since application start" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></Border><Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MEMORY PRESSURE" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Snapshot.MemoryPercent, StringFormat={}{0:F1}%}" FontSize="23" FontWeight="SemiBold" Margin="0,9"/><TextBlock Text="Current physical memory utilization" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></Border><Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="ACTIVE PROCESSES" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Snapshot.ProcessCount}" FontSize="23" FontWeight="SemiBold" Margin="0,9"/><TextBlock Text="Currently running on this device" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="CPU utilization · recent readings" FontSize="15" FontWeight="SemiBold"/><controls:SparklineChart Height="260" Margin="0,18,0,5" Values="{Binding CpuHistory}" Stroke="{DynamicResource AccentBrush}" SecondaryValues="{Binding MemoryHistory}" SecondaryStroke="{DynamicResource PurpleBrush}"/><TextBlock Text="CSV and PDF exports are written to your Documents folder. The chart contains the current session's live samples." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
     <TabItem><StackPanel Margin="0,8,0,18"><TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Personalize your Nexus workspace." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,20"/><Border Style="{StaticResource PanelCard}" Margin="0,0,0,14"><Grid><StackPanel><TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Choose the workspace color theme." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button Style="{StaticResource ActionButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding ThemeLabel}" Command="{Binding ToggleThemeCommand}"/></Grid></Border><Border Style="{StaticResource PanelCard}" Margin="0,0,0,14"><Grid><StackPanel><TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Show in-app toast notifications for system actions." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel><CheckBox IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" Content="Enabled" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border><Border Style="{StaticResource PanelCard}" Margin="0,0,0,14"><StackPanel><TextBlock Text="System information" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding HostSummary}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="Monitoring interval: 1 second  ·  History buffer: 60 samples  ·  Shortcuts: Ctrl+1–6 modules, Ctrl+R refresh" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border><Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="Data and privacy" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Activity events are stored locally in a SQLite database under your Windows Local AppData folder. Telemetry is read from this device and is not transmitted." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></TabItem>
    </TabControl>
    <Grid Grid.Row="2"><TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#35D39A"/><TextBlock Text="  LOCAL DEVICE" FontSize="9" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Grid>
    <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,12,0" Background="#263C68" BorderBrush="#527AC2" BorderThickness="1" CornerRadius="10" Padding="14,10" Visibility="{Binding ShowToast, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ToastMessage}" MaxWidth="360" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="×" Style="{StaticResource NavButton}" Command="{Binding CloseToastCommand}" Padding="7,2" Margin="8,0,0,0"/></Grid></Border>
   </Grid>
  </Grid>
 </Grid>
